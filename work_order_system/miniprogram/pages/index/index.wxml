<view class="container">
  <view class="card">
    <view class="row"><text class="label">登录状态</text><text class="value">{{statusText}}</text></view>
    <view class="row"><text class="label">openid</text><text class="value small">{{openid || '—'}}</text></view>
    <view class="row"><text class="label">订阅余量</text><text class="value">{{quota}}</text></view>
  </view>

  <view class="card">
    <view class="row"><text class="label">姓名(可选)</text></view>
    <input class="input" placeholder="如：张三" value="{{name}}" bindinput="onNameInput" />
    <button class="btn" bindtap="onSubscribeAndRegister">授权订阅并注册</button>
    <button class="btn btn-ghost" bindtap="goTodo">查看我的待办</button>
  </view>
</view>
